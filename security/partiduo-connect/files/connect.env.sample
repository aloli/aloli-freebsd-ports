# /usr/local/etc/partiduo-connect/connect.env — environnement de connect
# (Partiduo, ADR-012), lu par le script rc.d partiduo_connect.
# root:partiduo-connect, mode 0640. Syntaxe sh (VARIABLE=valeur).

# Réglages de production de Marten (config/connect/settings/production.cr).
MARTEN_ENV=production
# Clé secrète (sessions, jetons CSRF) : longue et aléatoire, par exemple
#   openssl rand -hex 32
# La même sur tous les serveurs connect d'un domaine (ADR-012 D5).
MARTEN_SECRET_KEY=

# Base de connect (rôle partiduo-connect, socket Unix, authentification
# peer) : su -m postgres -c 'createuser partiduo-connect &&
#   createdb --owner=partiduo-connect --encoding=UTF8 partiduo_connect'
DATABASE_URL=postgres:///partiduo_connect?host=/tmp

# Port d'écoute, sur 127.0.0.1 seulement : le serveur mandataire de
# connect.<domaine> (nginx) termine TLS et pose X-Forwarded-Proto.
PORT=8300

# Domaine du parc ; hôte et adresse publique (émetteur des jetons ; défauts :
# connect.<domaine> et https://connect.<domaine>).
PARTIDUO_DOMAIN=partiduo.app
#PARTIDUO_CONNECT_HOST=connect.partiduo.app
#PARTIDUO_CONNECT_URL=https://connect.partiduo.app

# Clés de signature des jetons (JWK privées ES256, la première signe, toutes
# sont publiées) : fichier root:partiduo-connect 0640, posé depuis le coffre
# (partiduo-connect-manage signing-key generate). Exigé.
PARTIDUO_CONNECT_SIGNING_KEYS=/usr/local/etc/partiduo-connect/signing-keys.json

# Avis aux personnes (nouvelle passkey, codes régénérés…) : compte SMTP de
# Partiduo (marten-mail), jamais le relais du serveur ; expéditeur.
PARTIDUO_CONNECT_SMTP_URL=
PARTIDUO_CONNECT_MAIL_FROM=notifications@partiduo.app

# Facultatif : partie de confiance WebAuthn (défaut : le domaine), origines
# admises, coût bcrypt (défaut : 12).
#PARTIDUO_CONNECT_RP_ID=partiduo.app
#PARTIDUO_CONNECT_WEBAUTHN_ORIGINS=https://connect.partiduo.app
#PARTIDUO_BCRYPT_COST=12
